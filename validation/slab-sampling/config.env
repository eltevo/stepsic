# Stable defaults for slab histograms, power transfer, and cube-cut comparison.
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

LCUBE="${LCUBE:-1000}"
LBOX_SLAB="${LBOX_SLAB:-1000 1000 200}"
LZ_MIN="${LZ_MIN:-100}"
LPT="${LPT:-2}"
Z="${Z:-31}"
METHOD="${METHOD:-cic}"
SEED="${SEED:-137}"
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"
TAPER_FRAC="${TAPER_FRAC:-0.25}"
MU_SPLIT="${MU_SPLIT:-0.5}"
YLIM="${YLIM:-0.9949 1.0051}"
PERCENT_BAND="${PERCENT_BAND:-0.005}"
