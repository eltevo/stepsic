# Stable defaults for slab histograms, power transfer, cube-cut comparison, and covariance.
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

LCUBE="${LCUBE:-1000}"
LBOX_SLAB="${LBOX_SLAB:-1000 1000 200}"
LZ_MIN="${LZ_MIN:-100}"
LPT="${LPT:-2}"
Z="${Z:-31}"
METHOD="${METHOD:-cic}"
SEED="${SEED:-137}"
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"
YLIM="${YLIM:-0.994 1.006}"
PERCENT_BAND="${PERCENT_BAND:-0.001}"
COV_ASPECTS="${COV_ASPECTS:-1 2 5 10}"            # cube side / slab thickness
COV_FILTER_SCALE="${COV_FILTER_SCALE:-0.1}"      # Gaussian filter k_s [h/Mpc]
