# Stable defaults for grid power-recovery validation.
# Override stable defaults through the environment; sizing comes from a profile.
#
# Each panel isolates one parameter dimension while holding the others
# fixed. All panels use paired-fixed averaging (Angulo & Pontzen 2016).

# Shared parameters
LBOX="${LBOX:-1000}"                  # cubic box side [Mpc/h]
SEED="${SEED:-137}"                   # white-noise RNG seed
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"  # k_max as fraction of Nyquist

# Panel A: resolution dependence (multiple nmesh)

# Panel B: redshift dependence (multiple z)

# Panel C: LPT order comparison (1LPT vs 2LPT)

# Panel D: MAS scheme comparison (NGP / CIC / TSC)

# Plot
YLIM="${YLIM:-0.99 1.01}"

# Environment
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
