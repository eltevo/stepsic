# cylinder/config.env - default parameters for cylindrical end-to-end validation
# Override by exporting variables or passing --config=<path> to run.sh.

# -- Paths ------------------------------------------------------------------
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPS_ENV="${STEPS_ENV:-steps}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

# -- Parallelism ------------------------------------------------------------
STEPS_BACKEND="${STEPS_BACKEND:-cuda}"
N_MPI="${N_MPI:-1}"
N_GPU="${N_GPU:-1}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# -- Cylinder geometry ------------------------------------------------------
R_3D="${R_3D:-500}"
D_4D="${D_4D:-35}"
RCRIT="${RCRIT:-50}"
LZ="${LZ:-1000}"

# -- Shell discretization ---------------------------------------------------
NRBINS="${NRBINS:-384}"
NSHELL="${NSHELL:-768}"
BIN_MODE="${BIN_MODE:-omega}"

# -- Cosmological IC parameters ---------------------------------------------
SIM_Z_INIT="${SIM_Z_INIT:-31}"
SIM_LPTORDER="${SIM_LPTORDER:-2}"
SIM_NMESH="${SIM_NMESH:-256}"

# -- Target cosmology (Planck 2018 EE+BAO) ----------------------------------
COSMOLOGY_NAME="${COSMOLOGY_NAME:-Planck2018EE+BAO}"
COSMO_OMEGA_B="${COSMO_OMEGA_B:-0.04897}"
COSMO_OMEGA_M="${COSMO_OMEGA_M:-0.3111}"
COSMO_OMEGA_L="${COSMO_OMEGA_L:-0.6889}"
COSMO_H0="${COSMO_H0:-67.66}"

# -- Glass-making runtime (EdS cosmology) -----------------------------------
# All glass runs use EdS background (Omega_m=1) for optimal convergence.
# H0_EdS = 100 km/s/Mpc (h_EdS = 1); see vlib::cosmology::eds_h0 in
# validation/_common/lib.sh for the rationale.
GLASS_TIME_LIMIT_MIN="${GLASS_TIME_LIMIT_MIN:-3600}"
GLASS_A_START="${GLASS_A_START:-0.00001}"
GLASS_A_MAX="${GLASS_A_MAX:-100.0}"
GLASS_ACC_PARAM="${GLASS_ACC_PARAM:-0.0125}"
GLASS_STEP_MIN="${GLASS_STEP_MIN:-0.0000000075}"
GLASS_STEP_MAX="${GLASS_STEP_MAX:-1250.0}"

# -- LCDM simulation parameters ---------------------------------------------
SIM_IS_PERIODIC="${SIM_IS_PERIODIC:-3}"
SIM_ACC_PARAM="${SIM_ACC_PARAM:-0.0125}"
SIM_STEP_MIN="${SIM_STEP_MIN:-0.00002}"
SIM_STEP_MAX="${SIM_STEP_MAX:-0.03125}"
SIM_TIME_LIMIT_MIN="${SIM_TIME_LIMIT_MIN:-3600}"
SIM_RADIAL_FORCE_ACCURACY="${SIM_RADIAL_FORCE_ACCURACY:-7500}"
SIM_RADIAL_FORCE_TABLE_SIZE="${SIM_RADIAL_FORCE_TABLE_SIZE:-500}"

# -- P(k) measurement parameters --------------------------------------------
PK_NMESH="${PK_NMESH:-128}"
PK_P0="${PK_P0:-100}"
PK_NRADIAL_BINS="${PK_NRADIAL_BINS:-3}"
PK_NFKP_RADIAL_BINS="${PK_NFKP_RADIAL_BINS:-32}"
PK_RANDOMS_NFACTOR="${PK_RANDOMS_NFACTOR:-50}"
PK_RANDOMS_SEED="${PK_RANDOMS_SEED:-42}"
