# slab/config.env - default parameters for the native-slab vs cube-cut
# fair-sample comparison.
# Override by exporting variables or passing --config=<path>.

STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

LCUBE="${LCUBE:-1000}"          # cube side [Mpc/h]
ASPECT="${ASPECT:-10}"          # slab aspect s (Lz = LCUBE/s)
NMESH="${NMESH:-256}"           # cells along the cube side
LPT="${LPT:-2}"
Z="${Z:-31}"
SEED="${SEED:-137}"
NREAL="${NREAL:-5}"
PAIRED="${PAIRED:-true}"    # all statistics here are second order
TAPER_FRAC="${TAPER_FRAC:-0.25}"    # Tukey taper fraction of half-thickness
MU_SPLIT="${MU_SPLIT:-0.5}"         # |k_z|/k boundary for the mu bins
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"
