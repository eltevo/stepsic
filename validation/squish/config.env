# squish/config.env - default parameters for the P(k) aspect-ratio test
# Override by exporting variables or passing --config=<path> to run.sh.

# Box geometry
LCUBE="${LCUBE:-1000}"          # cubic base side length [Mpc/h]
LZ_MIN="${LZ_MIN:-100}"         # minimum z-dimension [Mpc/h]
NSTEPS="${NSTEPS:-4}"           # number of aspect-ratio steps

# LPT / grid
NMESH="${NMESH:-48}"            # cells along shortest dimension
LPT="${LPT:-2}"                 # LPT order (1 or 2)
Z="${Z:-31}"                    # target redshift
METHOD="${METHOD:-cic}"         # mass-assignment scheme: ngp, cic, tsc
SEED="${SEED:-137}"             # white-noise RNG seed
NREAL="${NREAL:-1}"             # independent realisations to average
PAIRED="${PAIRED:-true}"        # Angulo & Pontzen paired-fixed averaging
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"  # k_max as fraction of Nyquist

# Plot
YLIM="${YLIM:-0.998 1.002}"     # y-axis limits (two space-separated floats)
PERCENT_BAND="${PERCENT_BAND:-0.0005}"  # shaded percent-error band

# Environment
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
