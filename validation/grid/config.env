# grid/config.env - default parameters for P(k) recovery grid validation
# Override by exporting variables or passing --config=<path> to run.sh.
#
# Each panel isolates one parameter dimension while holding the others
# fixed. All panels use paired-fixed averaging (Angulo & Pontzen 2016).

# Shared parameters
LBOX="${LBOX:-1000}"                  # cubic box side [Mpc/h]
SEED="${SEED:-137}"                   # white-noise RNG seed
NREAL="${NREAL:-1}"                   # realisations to average
PAIRED="${PAIRED:-true}"              # Angulo & Pontzen paired-fixed averaging
KMAX_FRAC_NY="${KMAX_FRAC_NY:-0.8}"  # k_max as fraction of Nyquist

# Panel A: resolution dependence (multiple nmesh)
PANEL_A_NMESH="${PANEL_A_NMESH:-128 256 512}"
PANEL_A_LPT="${PANEL_A_LPT:-2}"
PANEL_A_Z="${PANEL_A_Z:-31}"
PANEL_A_METHOD="${PANEL_A_METHOD:-cic}"

# Panel B: redshift dependence (multiple z)
PANEL_B_NMESH="${PANEL_B_NMESH:-512}"
PANEL_B_LPT="${PANEL_B_LPT:-2}"
PANEL_B_Z="${PANEL_B_Z:-63 31 15}"
PANEL_B_METHOD="${PANEL_B_METHOD:-cic}"

# Panel C: LPT order comparison (1LPT vs 2LPT)
PANEL_C_NMESH="${PANEL_C_NMESH:-512}"
PANEL_C_LPT="${PANEL_C_LPT:-1 2}"
PANEL_C_Z="${PANEL_C_Z:-15}"
PANEL_C_METHOD="${PANEL_C_METHOD:-cic}"

# Panel D: MAS scheme comparison (NGP / CIC / TSC)
PANEL_D_NMESH="${PANEL_D_NMESH:-512}"
PANEL_D_LPT="${PANEL_D_LPT:-2}"
PANEL_D_Z="${PANEL_D_Z:-31}"
PANEL_D_METHOD="${PANEL_D_METHOD:-ngp cic tsc}"

# Plot
YLIM="${YLIM:-0.99 1.01}"

# Environment
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
