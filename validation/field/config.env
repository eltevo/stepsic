# field/config.env - default parameters for displacement/velocity field validation
# Override by exporting variables or passing --config=<path> to run.sh.

# Box geometry
LBOX_3D="${LBOX_3D:-1000 1000 1000}"   # 3D box dimensions Lx Ly Lz [Mpc/h]
LBOX_SLAB="${LBOX_SLAB:-1000 1000 200}" # slab box dimensions [Mpc/h]

# LPT / grid
NMESH_3D="${NMESH_3D:-128}"    # cells along shortest dimension, 3D box
NMESH_SLAB="${NMESH_SLAB:-64}" # cells along shortest dimension, slab
Z="${Z:-31}"                    # target redshift
METHOD="${METHOD:-cic}"         # mass-assignment scheme: ngp, cic, tsc
SEED="${SEED:-137}"             # white-noise RNG seed
NREAL="${NREAL:-200}"           # realisations to average (200 for good statistics)
NBINS="${NBINS:-120}"           # histogram bins

# Environment
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
