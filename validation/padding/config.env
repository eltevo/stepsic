# padding/config.env - default parameters for the periodic-embedding
# padding sweep. Override by exporting variables or passing --config=<path>.

# -- Conda environment -------------------------------------------------------
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

# -- Domain geometry ---------------------------------------------------------
# GEOMETRY: spherical (default) or cylindrical (radial embedding only;
# the z axis is genuinely periodic and is not padded).
GEOMETRY="${GEOMETRY:-spherical}"
R_3D="${R_3D:-500}"
D_4D="${D_4D:-75}"
RCRIT="${RCRIT:-100}"
BIN_MODE="${BIN_MODE:-omega}"
NRBINS="${NRBINS:-64}"
NSHELL="${NSHELL:-1024}"
LZ="${LZ:-500}"

# -- Field resolution and sweep ----------------------------------------------
# NGRID0: voxels across the domain diameter 2*R_3D; fixes the cell size
# delta = 2*R_3D/NGRID0 for every box in the sweep.
# ALPHAS: padding ratios LBOX/(2*R_3D), ascending; the last entry is the
# reference. Each alpha*NGRID0 must be an even integer (voxel-aligned crop).
NGRID0="${NGRID0:-128}"
ALPHAS="${ALPHAS:-1.0 1.125 1.25 1.5 2.0}"
LPT="${LPT:-2}"
Z="${Z:-31}"

# -- Realizations ------------------------------------------------------------
SEED="${SEED:-137}"
NSEEDS="${NSEEDS:-10}"
LOAD_SEED="${LOAD_SEED:-42}"

# -- Metrics -----------------------------------------------------------------
BOUNDARY_FRAC="${BOUNDARY_FRAC:-0.05}"
CORE_FRAC="${CORE_FRAC:-0.5}"
PK_NMESH="${PK_NMESH:-64}"
NPROF="${NPROF:-25}"
