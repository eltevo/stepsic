# Stable defaults for generating and measuring glasses.
# Override stable defaults through the environment; sizing comes from a profile.

# -- Paths ------------------------------------------------------------------
GLASS_INPUT_MODE="${GLASS_INPUT_MODE:-generate}"
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPS_ENV="${STEPS_ENV:-steps}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
STEPS_BACKEND="${STEPS_BACKEND:-cuda}"

# -- Parallelism ------------------------------------------------------------
N_MPI="${N_MPI:-1}"
N_GPU="${N_GPU:-1}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# -- Physical parameters ----------------------------------------------------
LBOX="${LBOX:-1000}"
R_3D="${R_3D:-500}"
D_4D="${D_4D:-75}"
RCRIT="${RCRIT:-100}"
LZ="${LZ:-${LBOX:-1000}}"

# Shell discretization for spherical/cylindrical geometries.
BIN_MODE_STEPS="${BIN_MODE_STEPS:-omega}"

# Cubical pre-glass discretization.
BIN_MODE_CUBICAL="${BIN_MODE_CUBICAL:-omega}"

# -- Glass-making runtime (EdS cosmology) -----------------------------------
# All glass runs use EdS background (Omega_m=1) for optimal convergence.
# H0_EdS = 100 km/s/Mpc (h_EdS = 1) so that StePS's mass-consistency
# check matches stepsic's h-independent ICs; see vlib::cosmology::eds_h0
# in validation/_common/lib.sh.
GLASS_A_START="${GLASS_A_START:-0.00001}"
GLASS_A_MAX="${GLASS_A_MAX:-500.0}"
GLASS_ACC_PARAM="${GLASS_ACC_PARAM:-0.0001}"
GLASS_STEP_MIN="${GLASS_STEP_MIN:-0.0000000075}"
GLASS_STEP_MAX="${GLASS_STEP_MAX:-1250.0}"

# StePS snapshot output schedule (OUTPUT_TIME_VARIABLE=1, redshift).
# Default fires once near simulation end (z=999, then z=0). Override
# GLASS_FIRST_T_OUT to a redshift the run will actually cross (e.g. for
# short smoke-test wall-clock limits that never reach z=999).

# Softening lengths.
GLASS_SOFT_SHELL="${GLASS_SOFT_SHELL:-0.12}"
GLASS_SOFT_CUBIC="${GLASS_SOFT_CUBIC:-0.5}"

# -- Diagnostics (glass-quality diagnostics) ----------------------------------------------
# Each optional path overrides the snapshot produced by run.sh for that geometry.
GLASS_SNAP_CUBICAL="${GLASS_SNAP_CUBICAL:-}"
GLASS_SNAP_SPHERICAL="${GLASS_SNAP_SPHERICAL:-}"
GLASS_SNAP_CYLINDRICAL="${GLASS_SNAP_CYLINDRICAL:-}"
DIAG_TWIN_SEED="${DIAG_TWIN_SEED:-12345}" # Poisson-twin RNG seed
# Force dumps: StePS re-saves the IC with accelerations at run start;
# the a-interval only bounds the (discarded) evolution afterwards.
FORCE_A_START="${FORCE_A_START:-0.00001}"
FORCE_A_MAX="${FORCE_A_MAX:-0.0000101}"
