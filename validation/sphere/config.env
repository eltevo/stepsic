# sphere/config.env - default parameters for the fair-sample validation of
# embedded geometries against a periodic cube.
# Override by exporting variables or passing --config=<path>.

# -- Paths ------------------------------------------------------------------
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPS_ENV="${STEPS_ENV:-steps}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

# -- Geometry ----------------------------------------------------------------
# GEOMETRY selects spherical or cylindrical geometry; cylindrical runs also
# require LZ.
GEOMETRY="${GEOMETRY:-spherical}"
R_3D="${R_3D:-250}"
D_4D="${D_4D:-75}"
RCRIT="${RCRIT:-125}"
BIN_MODE="${BIN_MODE:-omega}"
NRBINS="${NRBINS:-128}"
NSHELL="${NSHELL:-4096}"
LZ="${LZ:-250}"

# Padding ratio of the shared Fourier box: LBOX = ALPHA * 2 * R_3D.
# Use a padding ratio supported by validation/padding.
ALPHA="${ALPHA:-2.0}"

# -- Field / LPT -------------------------------------------------------------
NMESH="${NMESH:-256}"
NMESHSAMPLES="${NMESHSAMPLES:-1}"
LPT="${LPT:-2}"
Z="${Z:-31}"
SEED="${SEED:-42}"

# -- IC-level comparison -------------------------------------------------------
# RCORE defaults to RCRIT (the constant-resolution region).
RCORE="${RCORE:-${RCRIT}}"
NCMP="${NCMP:-32}"
PK_NMESH="${PK_NMESH:-64}"
NPROF="${NPROF:-10}"
