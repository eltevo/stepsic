# Stable defaults for comparing embedded geometries with a periodic cube.
# Override stable defaults through the environment; sizing comes from a profile.

# -- Paths ------------------------------------------------------------------
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPS_ENV="${STEPS_ENV:-steps}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

# -- Geometry ----------------------------------------------------------------
# GEOMETRY selects spherical or cylindrical geometry; cylindrical runs also
# require LZ.
GEOMETRY="${GEOMETRY:-spherical}"
D_4D="${D_4D:-75}"
BIN_MODE="${BIN_MODE:-omega}"
LZ="${LZ:-250}"

# Padding ratio of the shared Fourier box: LBOX = ALPHA * 2 * R_3D.
# Use a padding ratio supported by validation/periodic-embedding.
ALPHA="${ALPHA:-2.0}"

# -- Field / LPT -------------------------------------------------------------
LPT="${LPT:-2}"
Z="${Z:-31}"
SEED="${SEED:-42}"

# -- IC-level comparison -------------------------------------------------------
# RCORE defaults to RCRIT (the constant-resolution region).
RCORE="${RCORE:-${RCRIT}}"
NPROF="${NPROF:-10}"

# -- Direct-reference control ---------------------------------------------------
# Relaxed glass snapshots; the direct-reference steps run only when both are set.
DIRECT_REFERENCE_SPHERICAL_GLASS="${DIRECT_REFERENCE_SPHERICAL_GLASS:-}"
DIRECT_REFERENCE_CYLINDRICAL_GLASS="${DIRECT_REFERENCE_CYLINDRICAL_GLASS:-}"
# Glass radius in the snapshot's own coordinate units, before rescaling to 250 Mpc/h.
DIRECT_REFERENCE_SPHERICAL_RADIUS="${DIRECT_REFERENCE_SPHERICAL_RADIUS:-}"
DIRECT_REFERENCE_CYLINDRICAL_RADIUS="${DIRECT_REFERENCE_CYLINDRICAL_RADIUS:-}"
# Archive of the mixing_variance step of periodic-embedding, drawn in the same
# figure; empty selects the periodic-embedding run of the same profile.
MIXING_VARIANCE_ARCHIVE="${MIXING_VARIANCE_ARCHIVE:-}"
