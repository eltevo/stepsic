# Stable defaults for stepsic <-> monofonIC agreement validation.
# Override stable defaults through the environment; sizing comes from a profile.

# -- Paths ------------------------------------------------------------------
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

MONOFONIC_REPO="${MONOFONIC_REPO:-https://bitbucket.org/ohahn/monofonic}"
MONOFONIC_ENV="${MONOFONIC_ENV:-monofonic}"

# -- Simulation parameters --------------------------------------------------
Z_INIT="${Z_INIT:-31}"
LPT_ORDER="${LPT_ORDER:-2}"
MAS_METHOD="${MAS_METHOD:-cic}"
SEED="${SEED:-137}"
