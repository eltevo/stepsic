# Evolved spherical StePS comparison against one matched periodic realization.

# -- Paths and environments -------------------------------------------------
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPS_ENV="${STEPS_ENV:-steps}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
REFERENCE_MANIFEST="${REFERENCE_MANIFEST:-${STEPSIC_SRC}/validation/periodic-lpt/runs/${VLIB_SIZE}/cache/current/pair-manifest.json}"
GLASS_INPUT_MODE="${GLASS_INPUT_MODE:-pre-generated}"
GLASS_SNAP="${GLASS_SNAP:-}"
EVOLVED_CACHE_DIR="${EVOLVED_CACHE_DIR:-}"

# -- Spherical geometry -----------------------------------------------------
R_3D="${R_3D:-250}"
D_4D="${D_4D:-75}"
RCRIT="${RCRIT:-125}"
BIN_MODE="${BIN_MODE:-omega}"
NRBINS="${NRBINS:-128}"
NSHELL="${NSHELL:-4096}"

# -- Matched cosmological field --------------------------------------------
SIM_Z_INIT="${SIM_Z_INIT:-31}"
SIM_Z_FINAL="${SIM_Z_FINAL:-0}"
SIM_LPTORDER="${SIM_LPTORDER:-2}"
SIM_SEED="${SIM_SEED:-42}"
SIM_SPECTRUM="${SIM_SPECTRUM:-camb}"
SIM_NONLINEAR="${SIM_NONLINEAR:-false}"
SIM_HALOFIT="${SIM_HALOFIT:-mead2020}"
SIM_INTERPOLATION="${SIM_INTERPOLATION:-cic}"
SIM_COMPENSATE="${SIM_COMPENSATE:-false}"
SIM_SPHEREMODE="${SIM_SPHEREMODE:-false}"
SIM_PAIRED="${SIM_PAIRED:-false}"
SIM_NMESHSAMPLES="${SIM_NMESHSAMPLES:-1}"
SIM_USE_DOUBLE="${SIM_USE_DOUBLE:-false}"

# -- StePS evolution --------------------------------------------------------
SIM_ACC_PARAM="${SIM_ACC_PARAM:-0.0125}"
SIM_STEP_MIN="${SIM_STEP_MIN:-0.00002}"
SIM_STEP_MAX="${SIM_STEP_MAX:-0.03125}"
SIM_TIME_LIMIT_MIN="${SIM_TIME_LIMIT_MIN:-3600}"
SIM_RADIAL_FORCE_ACCURACY="${SIM_RADIAL_FORCE_ACCURACY:-7500}"
SIM_RADIAL_FORCE_TABLE_SIZE="${SIM_RADIAL_FORCE_TABLE_SIZE:-500}"
SOFTENING_DIVISOR="${SOFTENING_DIVISOR:-40}"
GEOM_SOFTENING="${GEOM_SOFTENING:-}"
STEPS_BACKEND="${STEPS_BACKEND:-cuda}"

# -- HEALPix shell measurement ---------------------------------------------
# Empty resolves to 0.4–0.6 RCRIT and RCRIT + 0.4–0.6 (R_3D-RCRIT).
CL_SHELLS="${CL_SHELLS:-}"

# -- Full-selection power spectra ------------------------------------------
PK_RANDOM_SEED="${PK_RANDOM_SEED:-42}"
PK_P0="${PK_P0:-100}"
PK_NFKP_RADIAL_BINS="${PK_NFKP_RADIAL_BINS:-32}"
