# Stable defaults for the periodic-embedding sweep.
# Override stable defaults through the environment; sizing comes from a profile.

# -- Conda environment -------------------------------------------------------
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

# -- Domain geometry ---------------------------------------------------------
# GEOMETRY: spherical (default) or cylindrical (radial embedding only;
# the z axis is genuinely periodic and is not padded).
GEOMETRY="${GEOMETRY:-spherical}"
R_3D="${R_3D:-500}"
D_4D="${D_4D:-75}"
RCRIT="${RCRIT:-100}"
BIN_MODE="${BIN_MODE:-omega}"
LZ="${LZ:-500}"

# -- Field resolution and sweep ----------------------------------------------
# NGRID0: voxels across the domain diameter 2*R_3D; fixes the cell size
# delta = 2*R_3D/NGRID0 for every box in the sweep.
# ALPHAS: padding ratios LBOX/(2*R_3D), ascending; the last entry is the
# reference. Each alpha*NGRID0 must be an even integer (voxel-aligned crop).
LPT="${LPT:-2}"
Z="${Z:-31}"

# -- Linear structure-function comparison -------------------------------------
# FILTER_SCALE: Gaussian smoothing wavenumber k_s [h/Mpc]; the mesh resolves
# the filtered field when k_s is well below the Nyquist wavenumber
# pi*NGRID0/(2*R_3D).
FILTER_SCALE="${FILTER_SCALE:-0.05}"

# -- Random fields -----------------------------------------------------------
SEED="${SEED:-137}"
LOAD_SEED="${LOAD_SEED:-42}"

# -- Metrics -----------------------------------------------------------------
BOUNDARY_FRAC="${BOUNDARY_FRAC:-0.05}"
CORE_FRAC="${CORE_FRAC:-0.5}"

# -- Relative motion of glass particles ---------------------------------------
# Relaxed glass snapshots with coordinates in comoving Mpc; the glass steps
# run only when both are set.
RELATIVE_MOTION_SPHERICAL_GLASS="${RELATIVE_MOTION_SPHERICAL_GLASS:-}"
RELATIVE_MOTION_CYLINDRICAL_GLASS="${RELATIVE_MOTION_CYLINDRICAL_GLASS:-}"
# Glass radii and cylinder period [comoving Mpc], in the glass files' units.
RELATIVE_MOTION_SPHERICAL_RADIUS="${RELATIVE_MOTION_SPHERICAL_RADIUS:-531.4285714285714}"
RELATIVE_MOTION_CYLINDRICAL_RADIUS="${RELATIVE_MOTION_CYLINDRICAL_RADIUS:-750}"
RELATIVE_MOTION_CYLINDRICAL_PERIOD="${RELATIVE_MOTION_CYLINDRICAL_PERIOD:-200}"
# Finest-mesh cells along the shortest box axis at padding 1.
RELATIVE_MOTION_SPHERICAL_CELLS="${RELATIVE_MOTION_SPHERICAL_CELLS:-152}"
RELATIVE_MOTION_CYLINDRICAL_CELLS="${RELATIVE_MOTION_CYLINDRICAL_CELLS:-20}"
# Gaussian seeds of the relative-motion measurement.
RELATIVE_MOTION_NSEEDS="${RELATIVE_MOTION_NSEEDS:-20}"

# -- Relative displacement of two points from sums over modes -----------------
# Mesh cells across the sphere diameter and along the cylinder period, box
# widths in domain diameters, and the Gaussian filter k_s [h/Mpc] that removes
# the modes near the Nyquist frequency of these meshes.
TWO_POINT_SPHERICAL_CELLS="${TWO_POINT_SPHERICAL_CELLS:-288}"
TWO_POINT_CYLINDRICAL_CELLS="${TWO_POINT_CYLINDRICAL_CELLS:-48}"
TWO_POINT_PADDINGS="${TWO_POINT_PADDINGS:-1 1.25 1.5 2 3}"
TWO_POINT_FILTER_SCALE="${TWO_POINT_FILTER_SCALE:-0.4}"

# -- Mean density contrast, mean strain and shared modes ----------------------
# Mesh cells along the shortest box axis at padding 1, and Gaussian seeds.
MONOPOLE_SPHERICAL_CELLS="${MONOPOLE_SPHERICAL_CELLS:-80}"
MONOPOLE_CYLINDRICAL_CELLS="${MONOPOLE_CYLINDRICAL_CELLS:-16}"
MONOPOLE_NSEEDS="${MONOPOLE_NSEEDS:-200}"
# Fixed-amplitude seeds of the shared-mode variance.
MIXING_NSEEDS="${MIXING_NSEEDS:-16}"

# -- Evolved pair --------------------------------------------------------------
# Two evolved cylinders of one glass, one from a box of one diameter (sim_a, ics/a)
# and one from a box of two diameters (sim_b, ics/b); the steps run only when the
# directory, the randoms and the glass of the FKP estimator are set. Lengths in
# comoving Mpc. IC: initial conditions file below ics/a and ics/b. RADIUS: region
# about the axis of the spectra, density and shift. OUTER: outermost layer.
# BINS, NMESH, P0: n(r) bins, mesh cells and weight amplitude [Mpc^3] of the FKP
# estimator. KMAX: largest shell wavenumber compared [h/Mpc].
STEPS_SRC="${STEPS_SRC:-${HOME}/projects/StePS}"
EVOLVED_PAIR_DIR="${EVOLVED_PAIR_DIR:-}"
EVOLVED_PAIR_RANDOMS="${EVOLVED_PAIR_RANDOMS:-}"
EVOLVED_PAIR_GLASS="${EVOLVED_PAIR_GLASS:-}"
EVOLVED_PAIR_IC="${EVOLVED_PAIR_IC:-stepsic_cylindrical_R3D750_D4D35_Lz200_Ng7_z31_LPT2_cic/ic.hdf5}"
EVOLVED_PAIR_RADIUS="${EVOLVED_PAIR_RADIUS:-157}"
EVOLVED_PAIR_OUTER="${EVOLVED_PAIR_OUTER:-700 750}"
EVOLVED_PAIR_BINS="${EVOLVED_PAIR_BINS:-48}"
EVOLVED_PAIR_NMESH="${EVOLVED_PAIR_NMESH:-512}"
EVOLVED_PAIR_P0="${EVOLVED_PAIR_P0:-10000}"
EVOLVED_PAIR_KMAX="${EVOLVED_PAIR_KMAX:-1.46}"
