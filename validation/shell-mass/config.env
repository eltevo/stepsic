# shell-mass/config.env - default parameters for shell mass distribution validation
# Override by exporting variables or passing --config=<path> to run.sh.
# All parameters can also be set via environment variables before running.

D4D="${D4D:-75}"                # compactification diameter D_4D [Mpc/h]
R3D="${R3D:-500}"               # simulation radius R_3D [Mpc/h]
NRBINS="${NRBINS:-224}"         # number of radial bins
NSHELL="${NSHELL:-12288}"       # particles per shell
LZ="${LZ:-200}"                 # cylinder height [Mpc/h]
RCRIT="${RCRIT:-}"              # critical radius for constant-resolution inner zone (empty = none)
RCRIT_MODES="${RCRIT_MODES:-omega}"  # binning methods that receive RCRIT

STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
