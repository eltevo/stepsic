# Periodic Gadget-4 reference for the evolved-geometry comparison.

# -- Paths and environments --------------------------------------------------
GADGET4_SRC="${GADGET4_SRC:-${HOME}/projects/Gadget4}"
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
GADGET4_ENV="${GADGET4_ENV:-stepsic}"
REFERENCE_CACHE_ROOT="${REFERENCE_CACHE_ROOT:-}"

# -- Parallelism -------------------------------------------------------------
N_MPI="${N_MPI:-2}"
N_BUILD="${N_BUILD:-2}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# -- Reference IC ------------------------------------------------------------
# Units are Mpc/h, 1e11 Msun/h, and km/s, matching HINDEPENDENT=true.
REF_LBOX_MPC_H="${REF_LBOX_MPC_H:-500}"
REF_NGRID="${REF_NGRID:-256}"
REF_NMESH="${REF_NMESH:-256}"
REF_PMGRID="${REF_PMGRID:-256}"
REF_SEED="${REF_SEED:-42}"
REF_Z_INIT="${REF_Z_INIT:-31}"
REF_Z_FINAL="${REF_Z_FINAL:-0}"
REF_RUN_1LPT="${REF_RUN_1LPT:-true}"
REF_SPECTRUM="${REF_SPECTRUM:-camb}"
REF_NONLINEAR="${REF_NONLINEAR:-false}"
REF_HALOFIT="${REF_HALOFIT:-mead2020}"
REF_INTERPOLATION="${REF_INTERPOLATION:-cic}"
REF_COMPENSATE="${REF_COMPENSATE:-false}"
REF_SPHEREMODE="${REF_SPHEREMODE:-false}"
REF_PAIRED="${REF_PAIRED:-false}"
REF_PHASE_SHIFT="${REF_PHASE_SHIFT:-0.0}"
REF_NMESHSAMPLES="${REF_NMESHSAMPLES:-1}"
REF_USE_DOUBLE="${REF_USE_DOUBLE:-false}"

# -- Gadget-4 integration ----------------------------------------------------
# Empty softening derives mean grid spacing / 40.
REF_SOFTENING_MPC_H="${REF_SOFTENING_MPC_H:-}"
GADGET_TIME_LIMIT_S="${GADGET_TIME_LIMIT_S:-172800}"
GADGET_RESTART_INTERVAL_S="${GADGET_RESTART_INTERVAL_S:-7200}"
GADGET_MAX_MEM_MB="${GADGET_MAX_MEM_MB:-4000}"
GADGET_ERR_TOL_INT="${GADGET_ERR_TOL_INT:-0.01}"
GADGET_ERR_TOL_FORCE="${GADGET_ERR_TOL_FORCE:-0.002}"
GADGET_MAX_TIMESTEP="${GADGET_MAX_TIMESTEP:-0.005}"

# -- Periodic 1LPT/2LPT control ---------------------------------------------
PK_NMESH="${PK_NMESH:-256}"
PK_KMAX_FRAC_NY="${PK_KMAX_FRAC_NY:-0.7}"
