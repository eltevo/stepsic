# monofonic/config.env - default parameters for stepsic <-> monofonIC cross-validation
# Override by exporting variables or passing --config=<path> to run.sh.

# -- Paths ------------------------------------------------------------------
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"
STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"

MONOFONIC_REPO="${MONOFONIC_REPO:-https://bitbucket.org/ohahn/monofonic}"
MONOFONIC_ENV="${MONOFONIC_ENV:-monofonic}"

# -- Simulation parameters --------------------------------------------------
LBOX="${LBOX:-1000}"
NMESH="${NMESH:-512}"
Z_INIT="${Z_INIT:-31}"
LPT_ORDER="${LPT_ORDER:-2}"
MAS_METHOD="${MAS_METHOD:-cic}"
SEED="${SEED:-137}"
NUM_THREADS="${NUM_THREADS:-$(nproc)}"

# -- Target cosmology (Planck 2018 EE+BAO best-fit, table 2.18) -------------
# N.B. monofonIC's built-in "Planck2018EE+BAO+SN" uses table 2.20, which has
# slightly different values. We specify everything explicitly (ParameterSet=none)
# to guarantee exact parameter-level agreement between the two codes.
COSMO_H0="${COSMO_H0:-67.702}"
COSMO_OMEGA_M="${COSMO_OMEGA_M:-0.3106}"
COSMO_OMEGA_B="${COSMO_OMEGA_B:-0.048972}"
COSMO_OMEGA_L="${COSMO_OMEGA_L:-0.6894}"
COSMO_NS="${COSMO_NS:-0.96824}"
COSMO_AS="${COSMO_AS:-2.1073e-9}"
COSMO_SIGMA8="${COSMO_SIGMA8:-0.8110}"
COSMO_TCMB="${COSMO_TCMB:-2.7255}"
COSMO_YHE="${COSMO_YHE:-0.245425}"
COSMO_MNU="${COSMO_MNU:-0.06}"
COSMO_KPIVOT="${COSMO_KPIVOT:-0.05}"
COSMO_W0="${COSMO_W0:--1.0}"
COSMO_WA="${COSMO_WA:-0.0}"
# N_ur: 2 massless neutrinos when 1 massive is specified (N_eff=3.046 total).
COSMO_NUR="${COSMO_NUR:-2.046}"
