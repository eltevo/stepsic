# particle-load/config.env - default parameters for particle load validation
# Override by exporting variables or passing --config=<path> to run.sh.

# Physical geometry
LBOX="${LBOX:-500}"         # cubic box side [Mpc/h] (also base for non-cubic)
NGRID="${NGRID:-24}"        # grid cells per dimension (pre-glass IC grid)
NPART="${NPART:-8192}"      # target particle count per geometry
R_3D="${R_3D:-250}"         # simulation radius [Mpc/h]
D_4D="${D_4D:-35}"          # compactification diameter [Mpc/h]
NRBINS="${NRBINS:-128}"     # radial bins
NSHELL="${NSHELL:-512}"     # particles per shell
RCRIT="${RCRIT:-100}"       # constant-resolution interior radius [Mpc/h]
LZ="${LZ:-${LBOX:-500}}"   # cylinder height [Mpc/h]

# Cosmology name used in the stepsic TOML (must match a name stepsic recognises)
COSMOLOGY_TOML="${COSMOLOGY_TOML:-Planck2018EE+BAO}"

# stepsic.py entry point (absolute or relative to project root)
STEPSIC_SRC="${STEPSIC_SRC:-${HOME}/projects/stepsic}"
STEPSIC_PY="${STEPSIC_PY:-${STEPSIC_SRC}/stepsic.py}"

# Fraction of particles to plot (1.0 = all)
PLOT_FRACTION="${PLOT_FRACTION:-1.0}"

STEPSIC_ENV="${STEPSIC_ENV:-stepsic}"
